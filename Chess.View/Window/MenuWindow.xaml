<Window x:Class="Chess.View.Window.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:Chess.View.Converter"
        xmlns:icon="clr-namespace:Chess.View.Icon"
        xmlns:select="clr-namespace:Chess.View.Selector"
        xmlns:game="clr-namespace:Chess.ViewModel.Game;assembly=Chess.ViewModel"
        xmlns:piece="clr-namespace:Chess.View.Piece"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Background="DarkGray" Icon="/Icon/appIcon.png"
        Title="Chess.NET" Height="700" Width="700">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewCommand}" />
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="4*" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <Border Background="White" Grid.Row="0" CornerRadius="10" Margin="20">
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <piece:BlackKing Width="100" Height="100" />
                <TextBlock Text="Chess.NET"
               Foreground="Black"
               FontSize="60"
               FontWeight="Bold"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>
                <piece:BlackQueen Width="100" Height="100" />
            </StackPanel>
        </Border>

        <TextBlock Text="Select Game Mode" FontSize="24" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="NormalChessButton" Content="Normal Chess" Width="150" Height="50" Tag="NormalChess" FontSize="16" FontWeight="Bold" Background="Black" Foreground="White" Click="NormalChessClick"/>
            <Button Content="Chess960" Width="150" Height="50" Tag="Chess960" FontSize="16" FontWeight="Bold" Background="Black" Foreground="White" Click="Chess960Click"/>
        </StackPanel>

        <Button Content="Start Game" Width="200" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="3" FontSize="18" FontWeight="Bold" Background="Black" Foreground="White" Click="StartGameClick"/>
        <Button Content="Exit" Width="200" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="4" FontSize="18" FontWeight="Bold" Background="Black" Foreground="White" Click="ExitClick"/>
    </Grid>
</Window>